# ─── Hicore API ─────────────────────────────────────────────────
# Den butiks-UUID du fick av Hicore (huvudbutik räcker)
HICORE_STORE_ID=B04411B3-670D-4C11-AB4B-388492E8EB66

# API-nyckeln från Hicore (sandbox-nyckel just nu)
HICORE_API_KEY=53d1cd0b-7d5c-4985-a9b7-46b4311eaa2c

# Bas-URL till Hicore. Behöver bara ändras när ni går från sandbox till produktion.
HICORE_BASE_URL=https://hicoredrift5.hicorecloud.se/HiCoreApi


# ─── Slack ──────────────────────────────────────────────────────
# Bot-token från en Slack-app du skapat (börjar med xoxb-...)
# Behöver scopes: chat:write, files:write
SLACK_BOT_TOKEN=xoxb-din-bot-token-här

# Var rapporten ska postas. Använd #kanalnamn för publik kanal.
SLACK_CHANNEL=#all-vacker


# ─── Anthropic (för dagliga skämt) ──────────────────────────────
# API-nyckel från console.anthropic.com (börjar med sk-ant-...)
# Kostar ca 0,001 kr per dag — försumbart.
# Lämna tomt om ni vill att skriptet plockar slumpvis ur den interna listan istället.
ANTHROPIC_API_KEY=sk-ant-din-nyckel-här
